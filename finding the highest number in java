import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        int[] values = {10,15,7,23,3};

        int highest = values[0];

        for (int value : values) {
            if (value > highest) {
                highest = value;
            }
        }
        System.out.println("Highest value: " + highest);
    }
}
